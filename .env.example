# ==============================================================================
# DATABASE (PostgreSQL / Neon)
# ==============================================================================
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AUTHENTICATION (Direct Google OAuth 2.0 & Session Security)
# ==============================================================================
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
AUTH_SECRET="generate-a-secure-random-32-byte-hex-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: explicitly set if using a custom redirect URI
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# ==============================================================================
# SHOPIFY STORE INTEGRATION
# ==============================================================================
SHOPIFY_SHOP_NAME="your-store.myshopify.com"
SHOPIFY_CLIENT_ID="your-shopify-app-client-id"
SHOPIFY_CLIENT_SECRET="your-shopify-app-client-secret"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_your_admin_access_token"
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_secret"

# ==============================================================================
# CLOUDINARY (Media & Document CDN)
# ==============================================================================
